{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile for members and admins",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["member", "admin"] },
        "trainerId": { "type": "string" },
        "workoutPlanId": { "type": "string" },
        "dietPlanId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive", "pending"] },
        "registeredAt": { "type": "string", "format": "date-time" },
        "feeStatus": { "type": "string", "enum": ["paid", "pending"] },
        "registrationFee": { "type": "number" },
        "monthlyFee": { "type": "number" },
        "trainerFee": { "type": "number" },
        "dietFee": { "type": "number" },
        "totalFee": { "type": "number" },
        "lastPaymentDate": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "email", "role"]
    },
    "Trainer": {
      "title": "Trainer",
      "description": "Fitness trainer details",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "experience": { "type": "string" },
        "fees": { "type": "number" },
        "specializations": { "type": "array" },
        "photoURL": { "type": "string" },
        "bio": { "type": "string" }
      },
      "required": ["name", "experience", "fees"]
    },
    "WorkoutPlan": {
      "title": "Workout Plan",
      "description": "Predefined workout routines",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "goal": { "type": "string" },
        "duration": { "type": "string" },
        "intensity": { "type": "string" },
        "schedule": { "type": "object" },
        "description": { "type": "string" }
      },
      "required": ["name", "goal", "duration"]
    },
    "DietPlan": {
      "title": "Diet Plan",
      "description": "Nutrition and diet guidelines",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "additionalFee": { "type": "number" },
        "content": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["name", "type"]
    },
    "Product": {
      "title": "Product",
      "description": "Gym equipment and accessories for sale",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "specifications": { "type": "string" },
        "photoURL": { "type": "string" },
        "stock": { "type": "number" },
        "category": { "type": "string" }
      },
      "required": ["name", "price"]
    },
    "FAQ": {
      "title": "FAQ",
      "description": "Frequently Asked Questions",
      "type": "object",
      "properties": {
        "question": { "type": "string" },
        "answer": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["question", "answer"]
    },
    "Rule": {
      "title": "Rule",
      "description": "Gym rules and regulations",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content"]
    },
    "ContactMessage": {
      "title": "Contact Message",
      "description": "Inquiries from the contact form",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "read", "replied"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "message"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Payment records for fees and products",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["membership", "trainer_fee", "diet_plan", "product_purchase"] },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["success", "failed", "pending"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "type", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "Store orders",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customerDetails": { "type": "object" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["card", "cod"] },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerDetails", "items", "total", "paymentMethod", "status"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global application settings and contact info",
      "type": "object",
      "properties": {
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "whatsapp": { "type": "string" },
        "instagram": { "type": "string" },
        "facebook": { "type": "string" },
        "currency": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Member profiles"
    },
    "/trainers/{trainerId}": {
      "schema": "Trainer",
      "description": "Trainer profiles"
    },
    "/workoutPlans/{planId}": {
      "schema": "WorkoutPlan",
      "description": "Available workout plans"
    },
    "/dietPlans/{planId}": {
      "schema": "DietPlan",
      "description": "Available diet plans"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Gym equipment store"
    },
    "/faqs/{faqId}": {
      "schema": "FAQ",
      "description": "FAQ entries"
    },
    "/rules/{ruleId}": {
      "schema": "Rule",
      "description": "Gym rules and regulations"
    },
    "/contactMessages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Messages from contact form"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Payment records"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Store orders"
    },
    "/settings/{settingId}": {
      "schema": "Settings",
      "description": "Global application settings"
    }
  }
}
